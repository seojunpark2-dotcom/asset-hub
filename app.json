{
  "expo": {
    "name": "통합 자산관리",
    "slug": "asset-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "assethub",
    "android": {
      "package": "com.portfolio.assettracker",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.portfolio.assettracker",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0d570c29-f0c8-4099-b46b-baf2155216a3"
      }
    },
    "owner": "seojunpark2"
  }
}
